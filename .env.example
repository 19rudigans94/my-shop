# URL сайта для метаданных и sitemap
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# MongoDB
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password
MONGODB_URI=mongodb://your_mongo_user:your_mongo_password@mongo:27017/my-shop?authSource=admin

# Mail (SMTP)
NEXT_SMTP_HOST=mail.yourdomain.com
NEXT_SMTP_PORT=465
NEXT_SMTP_USER=info@yourdomain.com
NEXT_SMTP_PASSWORD=your_smtp_password
NEXT_FEEDBACK_MAIL=info@yourdomain.com

# PayLink (платёжный шлюз)
PAYLINK_SHOP_ID=your_shop_id
PAYLINK_SHOP_SECRET=your_shop_secret
PAYLINK_RETURN_URL=https://yourdomain.com/api/paylink/simple-verification

# AWS S3 (если используется для загрузки изображений)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=your_region
# AWS_S3_BUCKET=your_bucket_name